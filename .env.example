# --- Database ---
# Local Postgres with pgvector extension enabled.
DATABASE_URL=postgresql+psycopg://recall:recall@localhost:5432/recall

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM providers ---
# Fast/cheap generation model, routed through OpenRouter.
OPENROUTER_API_KEY=sk-or-placeholder
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Grading / adjudication / miss-explanations.
ANTHROPIC_API_KEY=sk-ant-placeholder
ANTHROPIC_MODEL=claude-sonnet-5

# --- Embeddings ---
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- App ---
ENV=development
CORS_ORIGINS=http://localhost:3000
